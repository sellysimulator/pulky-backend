# Every value is empty: an empty value means "use the default" (spec 13.2).

# Application
APP_NAME=
VERSION=
DEBUG=
HOST=
PORT=

# JSON list. Must never contain "*": the app sets allow_credentials=True.
# Default: ["https://pulkysim.web.app", "http://localhost:5173"]
CORS_ORIGINS=

# Database: PostgreSQL. Defaults: localhost, 5432, postgres, (no password), pulkydb.
# Everyday local development uses a local Docker PostgreSQL 18 (DB_HOST=localhost,
# DB_PORT=5432, DB_USER=postgres, DB_SSL_CA empty, DB_REQUIRE_SSL=false), never
# the Neon database: a local backend against Neon is one more instance and takes
# Pulky over its connection budget during a deploy (DEPLOY.md).
# In production: Pulky's own Neon project, user neondb_owner, database pulkydb.
# DB_HOST is Neon's DIRECT endpoint (ep-....us-east-1.aws.neon.tech, without
# -pooler): the pooled endpoint rejects the startup option that sets the UTC
# time zone.
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_DATABASE=
# TLS is required by default (true: sslmode=require, encrypted but not
# verified); false only for a local PostgreSQL without TLS.
# DB_SSL_CA is the Let's Encrypt roots ISRG Root X1 + ISRG Root X2 in one PEM
# bundle (Neon's certificates chain to them; the same file for all four games)
# and turns on certificate and hostname verification (sslmode=verify-full;
# DB_HOST must then be the hostname, not an IP). Either the PEM text -- ONE line,
# UNQUOTED, \n between the PEM lines, as printed by
# `awk '{printf "%s\\n", $0}' neon-ca.pem` -- or a path to the PEM file, e.g.
# <Novus>/novus-secrets/neon-ca.pem. Not a secret. A value that is neither stops
# the app at boot.
DB_REQUIRE_SSL=
DB_SSL_CA=
# Connections per instance: DB_POOL_SIZE kept open (default 7) plus up to
# DB_MAX_OVERFLOW more under load (default 2). 9 per instance keeps a deploy
# (old and new instance side by side, plus alembic and one psql) within Pulky's
# budget of 20 connections (DEPLOY.md).
DB_POOL_SIZE=
DB_MAX_OVERFLOW=

# Redis -- optional. Live room state (lobbies, seating, the running game) is
# held in a key-value store; this switch chooses which one.
#   false (default) -- state lives in a dict inside this process. No Redis is
#     needed to run the app. Valid only for a SINGLE instance with no
#     `--workers`: two processes means two players in one room never see each
#     other. A restart ends every game in progress.
#   true -- state lives in Redis and Socket.IO fans out through it, so more
#     than one instance works and a restart does not lose live rooms.
#     REDIS_URL is then required (for example redis://localhost:6379/0); an
#     empty one refuses to start.
REDIS_ENABLED=
REDIS_URL=

# Firebase service account JSON, on a single line.
# Use single quotes or no quotes -- with double quotes python-dotenv decodes the
# \n inside private_key into real newlines and then fails to parse the line,
# leaving the variable silently unset.
FIREBASE_SERVICE_ACCOUNT_JSON=
