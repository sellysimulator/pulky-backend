# Every value is empty: an empty value means "use the default" (spec 13.2).

# Application
APP_NAME=
VERSION=
DEBUG=
HOST=
PORT=

# JSON list. Must never contain "*": the app sets allow_credentials=True.
# Default: ["https://pulkysim.web.app", "http://localhost:5173"]
CORS_ORIGINS=

# Database: PostgreSQL. Defaults: localhost, 5432, postgres, (no password), pulky.
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
# DB_DATABASE is this game's database on the shared Novus Aiven PostgreSQL
# service, e.g. pulky.
DB_DATABASE=
# TLS is required by default (true: sslmode=require, encrypted but not
# verified); false only for a local PostgreSQL without TLS.
# DB_SSL_CA is the CA certificate of the shared Novus Aiven PostgreSQL service
# (the same file for all four games) and turns on certificate and hostname
# verification (sslmode=verify-full; DB_HOST must then be the hostname, not an
# IP). Either the PEM text -- ONE line, UNQUOTED, \n between the PEM lines, as
# printed by `awk '{printf "%s\\n", $0}' aiven-pg-ca.pem` -- or a path to the
# PEM file, e.g. <Novus>/novus-secrets/aiven-pg-ca.pem. Not a secret. A value
# that is neither stops the app at boot.
DB_REQUIRE_SSL=
DB_SSL_CA=
# Connections per instance: DB_POOL_SIZE kept open (default 2) plus up to
# DB_MAX_OVERFLOW more under load (default 1). 3 per instance fits the
# shared 20-connection service (budget in DEPLOY.md); raise both on a bigger plan.
DB_POOL_SIZE=
DB_MAX_OVERFLOW=

# Redis -- optional. Live room state (lobbies, seating, the running game) is
# held in a key-value store; this switch chooses which one.
#   false (default) -- state lives in a dict inside this process. No Redis is
#     needed to run the app. Valid only for a SINGLE instance with no
#     `--workers`: two processes means two players in one room never see each
#     other. A restart ends every game in progress.
#   true -- state lives in Redis and Socket.IO fans out through it, so more
#     than one instance works and a restart does not lose live rooms.
#     REDIS_URL is then required (for example redis://localhost:6379/0); an
#     empty one refuses to start.
REDIS_ENABLED=
REDIS_URL=

# Firebase service account JSON, on a single line.
# Use single quotes or no quotes -- with double quotes python-dotenv decodes the
# \n inside private_key into real newlines and then fails to parse the line,
# leaving the variable silently unset.
FIREBASE_SERVICE_ACCOUNT_JSON=
